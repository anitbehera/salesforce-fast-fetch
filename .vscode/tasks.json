// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: watch",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom-webpack",
				"pattern": [
					{
						"regexp": "ERROR in ([^\\s]+) \\((\\d+),(\\d+)\\)",
						"file": 1,
						"line": 2,
						"column": 3,
						"severity": "error",
						"message": 0
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*Compiling.*",
					"endsPattern": ".*compiled successfully.*"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"npm: watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}