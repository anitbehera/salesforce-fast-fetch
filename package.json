{
  "name": "salesforce-fast-fetch",
  "displayName": "Salesforce Fast Fetch",
  "description": "Search and download Salesforce & Omnistudio components with ease!",
  "version": "0.0.1",
  "publisher": "Anit Behera",
  "license": "MIT",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "salesforceFastFetch",
          "title": "Salesforce Fast Fetch",
          "icon": "$(cloud-download)"
        }
      ]
    },
    "views": {
      "salesforceFastFetch": [
        {
          "type": "webview",
          "id": "salesforceFastFetch.sidebar",
          "name": "Search Components",
          "icon": "$(cloud-download)",
          "contextualTitle": "Salesforce Fast Fetch Sidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "salesforceFastFetch.helloWorld",
        "category": "Salesforce Fast Fetch",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run dev",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.39",
    "p-limit": "^7.1.1"
  }
}
